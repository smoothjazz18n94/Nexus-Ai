# Copy this file to ".env" (same folder) and fill in your values.
# ".env" is git-ignored. Never commit real keys, and never paste your key into chat, code or screenshots.

# REQUIRED for AI replies. Create a FREE key in Google AI Studio: https://aistudio.google.com/apikey
# Do NOT enable Cloud Billing on the key's project if you want to stay on the free tier.
GEMINI_API_KEY=your-gemini-api-key-here

# Which Gemini model to use. The default has a free tier as of Oct 2026.
# Other free options listed on Google's pricing page: gemini-3.8-flash, gemini-3.6-flash, gemini-3.1-flash-lite
# Check https://ai.google.dev/gemini-api/docs/pricing ("Free Tier" column) before changing it.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional settings (defaults shown)
PORT=3001
# Max length of each AI reply (includes any "thinking" tokens the model uses).
MAX_OUTPUT_TOKENS=4096
# Give up if Gemini sends nothing for this many milliseconds (first token or mid-stream).
REQUEST_TIMEOUT_MS=30000
# Max chat messages per minute per IP. Keep this at or below the requests-per-minute
# that AI Studio shows for your model, so you don't burn free-tier quota on errors.
CHAT_RATE_LIMIT_PER_MINUTE=8
# Where the SQLite file is stored (relative paths resolve from the project root).
DATABASE_PATH=data/nexus.db
# Max characters of earlier conversation sent with each request. Lower it to use fewer tokens.
CONTEXT_CHAR_BUDGET=48000
# Max characters in a single user message.
MAX_MESSAGE_CHARS=12000

# Set to true when deployed behind a proxy/load balancer (Render, Railway, Fly, nginx...)
# so rate limiting sees real client IPs.
TRUST_PROXY=false

# Only needed if the frontend is hosted on a DIFFERENT domain than this server.
# CORS_ORIGIN=https://your-frontend.example.com

# Telegram bot integration (optional; configure together on Render).
# Create the bot with @BotFather and keep the token private.
# TELEGRAM_BOT_TOKEN=replace-this-with-a-token-from-botfather
# Generate a 32+ character secret containing only letters, numbers, _ or -.
# TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret
# Used only by the webhook-registration script; Render's RENDER_EXTERNAL_URL is also supported.
# TELEGRAM_WEBHOOK_URL=https://your-render-service.onrender.com/api/telegram/webhook
