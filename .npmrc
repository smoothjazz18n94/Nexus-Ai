# Don't run dependency install scripts.
# Why: better-sqlite3 ships ready-made binaries for Windows/macOS/Linux, but when a package-lock.json
# is present npm would otherwise try to COMPILE it from source with node-gyp. That needs Python and
# C++ build tools (Visual Studio Build Tools on Windows) and fails for most beginners.
# This also avoids running arbitrary code from dependencies at install time.
ignore-scripts=true
